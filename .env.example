# Local defaults work without this file. Never put server secrets in VITE_* variables.
PORT=2567
DB_PATH=data/knights.sqlite
PERSISTENCE=sqlite
ENABLE_DEMO=true
CORS_ORIGINS=http://localhost:5173
# Public frontend origin shown in wallet signatures; defaults to the first CORS_ORIGINS entry.
# WALLET_ORIGIN=http://localhost:5173
# Generate a strong value for hosted deployment. Locally a persistent random secret is created.
# SESSION_SECRET=
# For Render production use PERSISTENCE=supabase and set these privately on Render:
# SUPABASE_DB_URL=postgresql://postgres.PROJECT:ENCODED_PASSWORD@POOLER:6543/postgres
# Supabase database CA certificate (PEM; "\n" escapes allowed). Required for verified TLS.
# SUPABASE_DB_CA=
# AGE_REVIEWER_IDS must remain unset until scheduled evidence cleanup works.
# VITE_API_URL=https://your-server.onrender.com
# VITE_WS_URL=wss://your-server.onrender.com
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=
# AGE_REVIEWER_IDS=comma-separated-Supabase-user-UUIDs
# AGE_CLEANUP_SECRET=Edge-Function-and-Vault-only
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# BASE_SEPOLIA_RPC=https://sepolia.base.org
# RECORDS_ADDRESS=
# ATTESTOR_PRIVATE_KEY=
ALLOW_CHAIN_BROADCAST=false
# BADGE_METADATA_URI=https://your-domain/achievements/{id}.json

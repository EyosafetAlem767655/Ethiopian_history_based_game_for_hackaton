{
  "name": "ethiopian-knights",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:web": "vite --host 0.0.0.0 apps/web",
    "build": "vite build apps/web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:load": "tsx scripts/load.ts",
    "test:load:local": "tsx scripts/load-local.ts",
    "import:sqlite": "tsx scripts/import-sqlite.ts",
    "lint": "eslint .",
    "format": "prettier --write apps packages/shared scripts tests *.ts *.json *.js docs README.md"
  },
  "dependencies": {
    "@colyseus/core": "^0.16.24",
    "@colyseus/ws-transport": "^0.16.5",
    "@internationalized/date": "^3.12.4",
    "@mediapipe/tasks-vision": "^1.1.1",
    "@openzeppelin/contracts": "5.3.0",
    "@supabase/supabase-js": "^2.50.0",
    "colyseus.js": "^0.16.19",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "phaser": "^3.90.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "viem": "^2.30.0",
    "zod": "^3.25.0",
    "zustand": "^5.0.5"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.18",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript-eslint/parser": "^8.72.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.13.0",
    "ganache": "^7.9.2",
    "prettier": "3.6.2",
    "solc": "^0.8.30",
    "tailwindcss": "^4.1.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@11.5.1"
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "paths": { "/src/store.ts": ["./apps/web/src/store.ts"] }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/shared/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts"
  ]
}
